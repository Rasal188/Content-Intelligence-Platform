# Temporary Development Authentication Bypass Flag
# Set to "true" to enable local dashboard UI development without a connected Convex backend deployment
DEV_BYPASS_AUTH=true

# Convex Deployment URL
# Must follow valid Convex URL format (e.g. https://placeholder-app-123.convex.cloud or http://127.0.0.1:3210)
NEXT_PUBLIC_CONVEX_URL=https://placeholder-app-123.convex.cloud

# OllaGraph Configuration
# Leave empty or set value. Must never assume or invent an endpoint.
OLLAGRAPH_API_KEY=
OLLAGRAPH_API_URL=<verified endpoint>

# --------------------------------------------------
# LLM Models Configuration
# --------------------------------------------------
OLLIMA_API_KEY=
OLLIMA_API_BASE_URL=https://api.ollima.com

# ✍️ Humanizer → Claude Sonnet 4.6
OLLIMA_HUMANIZER_MODEL=claude-sonnet-4.6

# 🤖 AI-Text Detection → Claude Sonnet 4.6
OLLIMA_AI_DETECTION_MODEL=claude-sonnet-4.6

# 🔎 Plagiarism Analysis → Gemini 3.1 Pro Low
OLLIMA_PLAGIARISM_MODEL=gemini-3.1-pro-low

# 🌐 Source Discovery / Web Verification → Gemini 3.6 Flash High
OLLIMA_SOURCE_DISCOVERY_MODEL=gemini-3.6-flash-high

# Default fallback model
OLLIMA_MODEL=claude-sonnet-4.6

OLLIMA_TIMEOUT=60000
OLLIMA_MAX_RETRIES=2
OLLIMA_MAX_TOKENS=900
PROMPT_VERSION=v2
